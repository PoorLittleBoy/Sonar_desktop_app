ARG UBUNTU_IMAGE_DIGEST
FROM ubuntu@${UBUNTU_IMAGE_DIGEST}

ARG LINUX_APT_PACKAGES
ARG DENO_VERSION
ARG RUST_VERSION

COPY config/build-versions.env /tmp/build-versions.env
COPY script/ci/use-apt-snapshot.sh /tmp/use-apt-snapshot.sh
COPY script/ci/apt-install-pinned.sh /tmp/apt-install-pinned.sh

RUN set -eux; \
    chmod +x /tmp/use-apt-snapshot.sh /tmp/apt-install-pinned.sh; \
    VERSIONS_FILE=/tmp/build-versions.env /tmp/use-apt-snapshot.sh; \
    /tmp/apt-install-pinned.sh \
        ca-certificates \
        curl \
        unzip \
        build-essential \
        ${LINUX_APT_PACKAGES}; \
    curl -fsSL https://deno.land/install.sh | \
        DENO_INSTALL=/usr/local sh -s v${DENO_VERSION}; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal; \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

RUN echo 'export PATH="/root/.cargo/bin:$PATH"' > /etc/profile.d/cargo.sh \
    && chmod +x /etc/profile.d/cargo.sh