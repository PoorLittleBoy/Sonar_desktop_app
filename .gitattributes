# Default: let Git decide text/binary, but do not rewrite unexpectedly
* text=auto

# Force LF only for known text files (safe)
*.rs   text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Sources du frontend et ressources empaquetées : sans eol=lf explicite,
# elles tombent sous `* text=auto` et un checkout Windows (core.autocrlf=true
# par défaut sur Git for Windows) les matérialise en CRLF. Vite embarque alors
# un contenu différent de celui d'un checkout Linux : le bundle change de nom
# et le binaire final diverge, à commit et versions d'outils identiques.
# Constaté le 08/08/2026 : assets/index-30IFmrIC.js sur Windows contre
# assets/index-BvJNXkwD.js en conteneur Linux, pour le même tag v4.12.1.
*.vue  text eol=lf
*.ts   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.svg  text eol=lf
# labels.csv est livré comme ressource du bundle : ses fins de ligne entrent
# telles quelles dans l'installateur.
*.csv  text eol=lf
# hooks.nsh est compilé dans le setup.exe par makensis.
*.nsh  text eol=lf

# Vendored crates: DO NOT apply text normalization broadly.
# Keep vendored content byte-for-byte as committed.
src-tauri/vendor/** -text

# Explicitly mark known binaries (extra safety)
*.fst binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary
*.xz binary
*.bz2 binary
*.pdf binary
